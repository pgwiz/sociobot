# ── Sociobot Environment Configuration ───────────────────────

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Administrative Authorization
ADMIN_CHAT_ID=your_telegram_user_id
# Super Admins: Comma-separated user IDs with full user management powers (browse, unlink, ban, promote)
SUPER_ADMIN_IDS=your_telegram_user_id

# Stream Extractor API (Keyless Spotify & YouTube Resolution)
YTSP_API_BASE_URL=https://ytsp-api.pgwiz.cloud
YTSP_API_TIMEOUT=30
ENABLE_API_FALLBACK=true

# Database Connection (Neon Serverless PostgreSQL or SQLite)
# For Render / Cloud: strongly recommend Neon PostgreSQL so database persists across restarts:
# DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///sociobot.db
DATABASE_PATH=sociobot.db
DB_SCHEMA=sociobot
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
ENABLE_NEON_KEEPALIVE=false

# File Handling & Temporary Storage
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DL=3
AUTO_CLEANUP_TEMP=true

# Cache Settings
ENABLE_MEMORY_CACHE=true
MEMORY_CACHE_MAXSIZE=2000
MEMORY_CACHE_TTL_SECS=3600
DB_METADATA_TTL_DAYS=7
DB_SEARCH_TTL_HOURS=24

# Cloud Hosting & Health Checks (Render / Railway / VPS)
ENABLE_HEALTH_SERVER=true
API_HOST=0.0.0.0
PORT=8080
