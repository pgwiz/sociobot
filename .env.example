# ==============================================================================
# Sociobot Environment Configuration Example
# Copy this file to .env and configure with your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials
# ------------------------------------------------------------------------------
# Obtain from @BotFather on Telegram (Required)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Primary Administrator Telegram Numeric User ID
ADMIN_CHAT_ID=6684660360

# Additional Super Admin IDs (comma-separated numeric IDs)
SUPER_ADMIN_IDS=6684660360

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon or SQLite)
# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL (Recommended for cloud hosting like Render):
# DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Local SQLite fallback:
DATABASE_URL=sqlite:///sociobot.db
DATABASE_PATH=sociobot.db

# Custom PostgreSQL schema for table isolation (avoids collision when sharing a database)
DB_SCHEMA=sociobot

# asyncpg connection pool settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Neon keepalive: Pings PostgreSQL every 4 minutes to prevent cold-start compute suspension
ENABLE_NEON_KEEPALIVE=true

# ------------------------------------------------------------------------------
# 3. Channel Quota & Vault Settings
# ------------------------------------------------------------------------------
# Maximum number of private storage channels a free user can link (default: 5)
# Super admins can upgrade individual user quotas via /user <id> -> [ 💎 Upgrade Quota ]
DEFAULT_MAX_CHANNELS=5

# ------------------------------------------------------------------------------
# 4. Stream Extractor API Settings
# ------------------------------------------------------------------------------
# Upstream media extractor backend URL
YTSP_API_BASE_URL=https://ytsp-api.pgwiz.cloud
YTSP_API_TIMEOUT=30
ENABLE_API_FALLBACK=true

# ------------------------------------------------------------------------------
# 5. Media Downloads & Temp Directory
# ------------------------------------------------------------------------------
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DL=3
AUTO_CLEANUP_TEMP=true

# ------------------------------------------------------------------------------
# 6. Cache & Performance Settings
# ------------------------------------------------------------------------------
ENABLE_MEMORY_CACHE=true
MEMORY_CACHE_MAXSIZE=2000
MEMORY_CACHE_TTL_SECS=3600
DB_METADATA_TTL_DAYS=7
DB_SEARCH_TTL_HOURS=24

# ------------------------------------------------------------------------------
# 7. Cloud Hosting (Render / Railway / Fly.io / VPS) & Uvicorn Web Server
# ------------------------------------------------------------------------------
# On Render, $PORT is provided automatically in the environment (e.g. 10000).
# Sociobot binds to 0.0.0.0:$PORT and runs both the FastAPI web server & Telegram polling.
ENABLE_HEALTH_SERVER=true
API_HOST=0.0.0.0
PORT=8080
